# ========================
# SERVER ENVIRONMENT VARIABLES
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke GitHub!
# ========================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=system_billing
DB_PORT=3306

# Server
PORT=5000

# JWT Secret (gunakan string acak yang panjang dan aman)
JWT_SECRET=your_jwt_secret_key_here

# Midtrans Payment Gateway
# Dapatkan dari: https://dashboard.midtrans.com
MIDTRANS_CLIENT=Mid-client-xxxxxxxxxxxx
MIDTRANS_SERVER=Mid-server-xxxxxxxxxxxx
